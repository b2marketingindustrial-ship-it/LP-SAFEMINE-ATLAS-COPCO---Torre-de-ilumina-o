---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2.
 *
 * VARIANTE LOCAL (03/11/2026, pedido do usuário): estrutura da seção "Segmentos atendidos"
 * das LPs SEIVE, nas cores da Safe Mine. Faixa navy de largura total com o topo arredondado,
 * cabeçalho centrado, carrossel de cards brancos em três partes (foto, ícone com título e
 * descrição, rodapé com a chamada e a seta) e a faixa branca "Sua aplicação não está aqui?".
 * O card inteiro é o CTA `aplicacoes-{id}`.
 *
 * A faixa anula o padding de cima da composição e repõe o respiro por dentro; o de baixo fica,
 * em cinza, antes do FAQ.
 *
 * Atenção: `npm run compose` sobrescreve este arquivo com o da biblioteca: guarde-o antes.
 */
import { Image } from 'astro:assets'
import Eyebrow from '@components/Eyebrow.astro'
import Button from '@components/Button.astro'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const at = applications.title.indexOf(applications.titleHighlight)
const before = at >= 0 ? applications.title.slice(0, at) : applications.title
const after = at >= 0 ? applications.title.slice(at + applications.titleHighlight.length) : ''

// A faixa anula exatamente o padding do ritmo da composição: sem isso o fundo da seção
// aparece como uma tira acima ou abaixo do navy.
const BAND_MARGINS: Record<string, string> = {
  'centered-lead': '-mt-4',
  even: '-my-16',
  flow: '-mt-6 -mb-16',
  open: '-mt-20 -mb-10',
}
const bandMargins = BAND_MARGINS[rhythm] ?? '-my-16'
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm} container={false}>
  <div
    class:list={[
      'app-band navy-premium relative overflow-hidden rounded-t-[2rem] pt-20 pb-16 sm:rounded-t-[3rem] lg:pt-24 lg:pb-20',
      bandMargins,
    ]}
  >
    <span class="app-mesh pointer-events-none absolute inset-0" aria-hidden="true"></span>

    <div class="relative mx-auto max-w-page px-6 lg:px-10">
      <div class="mx-auto max-w-4xl text-center">
        <Eyebrow tone="light">{applications.eyebrow}</Eyebrow>
        <h2 class="mt-4 font-display text-[1.75rem] leading-[1.08] font-extrabold tracking-[-0.02em] text-neutral-light sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem]">
          {before}
          {at >= 0 && <span class="text-accent-orange-light">{applications.titleHighlight}</span>}
          {after}
        </h2>
        <p class="mt-5 font-sans text-[16px] leading-relaxed text-neutral-light/80 sm:text-[17px]">
          {applications.text}
        </p>
      </div>

      <div class="relative mt-10" data-carousel>
        <ul
          data-carousel-track
          tabindex="0"
          aria-label={applications.eyebrow}
          class="app-track -mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto scroll-smooth px-6 pt-2 pb-6 motion-reduce:scroll-auto sm:gap-5 lg:mx-0 lg:scroll-px-0 lg:px-0"
        >
          {applications.items.map((item) => (
            <li class="flex w-[82%] shrink-0 snap-start sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-2.5rem)/3)] xl:w-[calc((100%-3.75rem)/4)]">
              <button
                type="button"
                data-cta={`aplicacoes-${item.id}`}
                class="btn-slave-whats app-card group flex w-full flex-col overflow-hidden rounded-2xl text-left transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
              >
                <span class="relative block aspect-[4/3] overflow-hidden">
                  <Image
                    src={item.photo.src}
                    alt={item.photo.alt}
                    format="webp"
                    width={640}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                  <span
                    class="app-veil pointer-events-none absolute inset-0"
                    aria-hidden="true"
                  ></span>
                </span>

                <span class="flex flex-1 flex-col px-5 pt-5 pb-5">
                  <span class="flex items-center gap-3">
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-orange text-neutral-light">
                      <Icon name={item.icon} class="size-[18px]" />
                    </span>
                    <span class="font-display text-[1.1rem] leading-tight font-extrabold text-primary-dark-900">
                      {item.label}
                    </span>
                  </span>
                  <span class="mt-2 mb-4 line-clamp-2 min-h-[2lh] font-sans text-[14.5px] leading-snug text-ink-soft">
                    {item.description}
                  </span>
                  <span class="mt-auto flex items-center justify-between border-t border-primary-dark/10 pt-4">
                    <span class="font-sans text-[14px] font-semibold text-primary-dark-900 transition-colors duration-200 group-hover:text-accent-orange">
                      {applications.cardCta}
                    </span>
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-primary-dark/15 text-primary-dark-900 transition-[background-color,border-color,color] duration-300 group-hover:border-accent-orange group-hover:bg-accent-orange group-hover:text-neutral-light motion-reduce:transition-none">
                      <Icon name="arrow-right" class="size-4" />
                    </span>
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
        <div class="pointer-events-none absolute inset-y-0 -right-5 -left-5 hidden items-center justify-between lg:flex xl:-right-6 xl:-left-6">
          <button
            type="button"
            data-rail-prev
            aria-label="Aplicações anteriores"
            class="pointer-events-auto flex size-12 items-center justify-center rounded-full bg-neutral-light text-primary-dark-900 shadow-[0_10px_24px_-14px_rgb(0_0_0/0.6)] transition-colors duration-200 hover:bg-accent-orange hover:text-neutral-light disabled:opacity-0 disabled:hover:bg-neutral-light disabled:hover:text-primary-dark-900 motion-reduce:transition-none"
          >
            <Icon name="arrow-right" class="size-5 rotate-180" />
          </button>
          <button
            type="button"
            data-rail-next
            aria-label="Próximas aplicações"
            class="pointer-events-auto flex size-12 items-center justify-center rounded-full bg-neutral-light text-primary-dark-900 shadow-[0_10px_24px_-14px_rgb(0_0_0/0.6)] transition-colors duration-200 hover:bg-accent-orange hover:text-neutral-light disabled:opacity-0 disabled:hover:bg-neutral-light disabled:hover:text-primary-dark-900 motion-reduce:transition-none"
          >
            <Icon name="arrow-right" class="size-5" />
          </button>
        </div>

        {/* Abaixo de 1024px: setas sob o trilho, como no trilho dos diferenciais */}
        <div class="-mt-2 mb-4 flex items-center justify-center gap-3 lg:hidden">
          <button
            type="button"
            data-rail-prev
            aria-label="Aplicações anteriores"
            class="flex size-10 items-center justify-center rounded-full border border-white/25 text-neutral-light transition-[background-color,border-color,opacity] duration-200 hover:border-neutral-light hover:bg-white/10 disabled:opacity-35 motion-reduce:transition-none"
          >
            <Icon name="chevron-right" class="size-4 rotate-180" />
          </button>
          <button
            type="button"
            data-rail-next
            aria-label="Próximas aplicações"
            class="flex size-10 items-center justify-center rounded-full border border-white/25 text-neutral-light transition-[background-color,border-color,opacity] duration-200 hover:border-neutral-light hover:bg-white/10 disabled:opacity-35 motion-reduce:transition-none"
          >
            <Icon name="chevron-right" class="size-4" />
          </button>
        </div>
      </div>

      <div class="relative mt-4 flex flex-col gap-5 rounded-2xl bg-neutral-light px-6 py-5 shadow-[0_24px_48px_-28px_rgb(0_0_0/0.55)] sm:flex-row sm:items-center sm:justify-between lg:px-10">
        <div class="flex items-center gap-5">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-primary-dark/[0.07] text-primary-dark-900">
            <Icon name="chat" class="size-7" />
          </span>
          <p class="font-sans text-[15px] leading-snug text-ink-soft sm:text-[16px]">
            <strong class="block font-display text-[18px] font-extrabold text-primary-dark-900">
              {applications.help.title}
            </strong>
            {applications.help.text}
          </p>
        </div>
        <Button cta="aplicacoes-outras" size="md" class="w-full shrink-0 sm:w-auto">
          {cta.card}
        </Button>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Malha de pontos clara, esmaecida no meio para não disputar com os cards. */
  .app-mesh {
    background-image: radial-gradient(circle, rgb(255 255 255 / 0.1) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 50% 50%, transparent 30%, black 100%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, transparent 30%, black 100%);
  }

  .app-card {
    background-color: var(--color-neutral-light);
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.55);
  }

  .app-card:hover {
    box-shadow: 0 32px 60px -28px rgb(0 0 0 / 0.65);
  }

  /* Leve escurecimento no pé da foto, para a emenda com o card branco ficar limpa. */
  .app-veil {
    background: linear-gradient(to top, rgb(0 0 0 / 0.18) 0%, transparent 40%);
  }

  .app-track {
    scrollbar-width: none;
  }

  .app-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Setas do carrossel: andam uma tela de cards por vez e desligam nas pontas.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    // Dois pares de setas: laterais no desktop, sob o trilho abaixo de 1024px.
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')
    const prevs = root.querySelectorAll<HTMLButtonElement>('[data-rail-prev]')
    const nexts = root.querySelectorAll<HTMLButtonElement>('[data-rail-next]')
    if (!track || !prevs.length || !nexts.length) return

    const update = () => {
      const atStart = track.scrollLeft <= 4
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4
      prevs.forEach((b) => (b.disabled = atStart))
      nexts.forEach((b) => (b.disabled = atEnd))
    }
    // Anda de card em card no celular e de tela em tela no desktop.
    const step = () => {
      const card = track.querySelector<HTMLElement>('li')
      const one = card ? card.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : 0
      return Math.max(one, Math.floor(track.clientWidth / (one || 1)) * one) || track.clientWidth
    }
    const go = (dir: number) => track.scrollBy({ left: dir * step() })

    prevs.forEach((b) => b.addEventListener('click', () => go(-1)))
    nexts.forEach((b) => b.addEventListener('click', () => go(1)))
    track.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    update()
  })
</script>
