---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2.
 *
 * VARIANTE LOCAL (03/11/2026, pedido do usuário): layout da seção "Por que a Safe Mine" das
 * LPs SEIVE, nas cores da Safe Mine. Bloco navy em largura total com o fim do título em
 * verde, texto, 3 números e CTA; à direita, a foto nascendo do navy; e os 5 diferenciais
 * em cards brancos sobrepostos à base do bloco, com ícone em quadrado verde-claro ao lado
 * do título (trilho com setas abaixo de 1280px). A seção de cima arredonda a base por cima
 * do bloco, que sobe por baixo dela (`--lp-round`, global.css). O contrato é o mesmo da
 * biblioteca: 5 motivos, CTA `diferenciais-cta`, `tone`/`rhythm`. Registrado em
 * docs/BRIEFING.md (Desvios do padrão).
 *
 * ATENÇÃO: `npm run compose` recopia o componente da biblioteca e desfaz esta variante.
 */
import { Picture } from 'astro:assets'
import Section from '@components/Section.astro'
import Button from '@components/Button.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { why } from '@data/sections/diferenciais'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const titleTop = why.titleLines.slice(0, -1)
const titleBottom = why.titleLines.at(-1)
---

<Section id="diferenciais" tone={tone} rhythm={rhythm} container={false} class="relative">
  {/* Bloco navy em largura total; sobe por baixo da curva da seção de cima (o FAQ) */}
  <div
    class="why-hero navy-premium relative overflow-hidden"
    style="margin-top: calc(-1.5rem - var(--lp-round)); padding-top: var(--lp-round)"
  >
    {/* Foto à direita (desktop), com a borda esquerda esmaecida no navy */}
    <div class="why-photo absolute inset-y-0 right-0 hidden w-[58%] lg:block">
      <Picture
        src={why.scene.src}
        alt={why.scene.alt}
        widths={[640, 1020, 1280]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-[50%_45%]"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>

    <div class="relative z-[2] mx-auto max-w-page px-6 pt-16 pb-10 lg:px-10 lg:pt-20 lg:pb-36">
      <div class="max-w-xl lg:max-w-[44%] xl:max-w-[40rem]">
        <p class="flex items-center gap-4 font-sans text-[12px] font-semibold tracking-[0.18em] text-neutral-light/75 uppercase sm:text-[13px]">
          <span
            aria-hidden="true"
            class="h-[3px] w-9 shrink-0 rounded-full bg-accent-orange-light"
          ></span>
          {why.eyebrow}
        </p>
        <h2 class="mt-4 font-display text-[2.25rem] leading-[1.04] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-[2.75rem] lg:text-[2.6rem] xl:text-[3rem]">
          {/* Quebra forçada só no desktop; no celular o título corre */}
          {titleTop.map((line) => (
            <span class="lg:block">{line} </span>
          ))}
          <span class="text-accent-orange-light lg:block">{titleBottom}</span>
        </h2>
        <p class="mt-5 font-sans text-[16px] leading-relaxed text-neutral-light/75 sm:text-[17px]">
          {why.text}
        </p>
        <dl class="mt-7 grid grid-cols-3 border-y border-white/15 py-5">
          {why.metrics.map((metric) => (
            <div class="flex flex-col-reverse gap-1.5 border-l border-white/15 pl-3 first:border-l-0 first:pl-0 sm:pl-6">
              <dt class="font-sans text-[12px] leading-snug text-neutral-light/70 sm:text-[14px]">
                {metric.label}
              </dt>
              <dd class="font-display text-[1.35rem] leading-none font-extrabold whitespace-nowrap text-accent-orange-light sm:text-[2rem]">
                {metric.value}
              </dd>
            </div>
          ))}
        </dl>
        <div class="mt-7">
          <Button cta="diferenciais-cta" size="lg" class="w-full sm:w-auto">
            {cta.primary}
          </Button>
        </div>
      </div>
    </div>

    {/* Foto em faixa no rodapé do bloco (mobile) */}
    <div class="why-photo-mobile relative h-64 sm:h-80 lg:hidden">
      <Picture
        src={why.scene.src}
        alt={why.scene.alt}
        widths={[640, 1020]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-[50%_45%]"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>
  </div>

  {/* Cards sobrepostos à base do bloco navy */}
  <div data-why class="relative z-10 mx-auto -mt-16 max-w-page px-6 lg:-mt-20 lg:px-10">
    <ul
      class="why-track scroll-track -mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-3 lg:-mx-10 lg:scroll-px-10 lg:px-10 xl:mx-0 xl:grid xl:grid-cols-5 xl:gap-3 xl:overflow-visible xl:px-0 xl:pb-0 2xl:gap-4"
      aria-label={why.eyebrow}
    >
      {/* Ícone e título na mesma linha, título sem quebra; a descrição reserva duas linhas. */}
      {why.reasons.map((reason) => (
        <li class="flex w-[82%] shrink-0 snap-start flex-col rounded-2xl bg-neutral-light p-5 shadow-[0_24px_48px_-26px_rgb(10_29_77/0.5)] sm:w-[46%] lg:w-[31%] xl:w-auto xl:p-4">
          <div class="flex items-center gap-2.5 xl:gap-2">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-orange/12 text-accent-orange xl:size-8">
              <Icon name={reason.icon} class="size-5" />
            </span>
            <h3 class="font-display text-[16px] leading-snug font-extrabold whitespace-nowrap text-primary-dark-900 xl:text-[14px]">
              {reason.title}
            </h3>
          </div>
          <p class="mt-3 min-h-[3.25em] font-sans text-[14px] leading-relaxed text-ink-soft">
            {reason.description}
          </p>
        </li>
      ))}
    </ul>

    <div class="mt-3 flex items-center justify-center gap-3 xl:hidden">
      <button
        type="button"
        data-why-prev
        aria-label="Diferencial anterior"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark-900"
      >
        <Icon name="chevron-right" class="size-4 rotate-180" />
      </button>
      <button
        type="button"
        data-why-next
        aria-label="Próximo diferencial"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark-900"
      >
        <Icon name="chevron-right" class="size-4" />
      </button>
    </div>
  </div>
</Section>

<style>
  .why-hero {
    isolation: isolate;
  }

  /* A foto nasce do navy pela esquerda: máscara, para não haver cor a casar. */
  .why-photo {
    -webkit-mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.6) 12%, #000 26%);
    mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.6) 12%, #000 26%);
  }

  /* No mobile, a faixa da foto nasce do navy por cima. */
  .why-photo-mobile {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 35%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 35%);
  }
</style>

<script>
  // Setas do trilho de cards abaixo de 1280px.
  document.querySelectorAll<HTMLElement>('[data-why]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.why-track')
    const prev = root.querySelector<HTMLButtonElement>('[data-why-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-why-next]')
    if (!track || !prev || !next) return

    const step = () => {
      const card = track.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.8
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))
  })
</script>
