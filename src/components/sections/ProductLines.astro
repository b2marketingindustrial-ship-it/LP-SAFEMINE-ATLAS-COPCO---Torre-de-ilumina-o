---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2, com o layout do mockup de
 * 29/10/2026 nesta LP (desvio registrado em docs/BRIEFING.md). `npm run compose`
 * sobrescreve este arquivo com o da biblioteca: guarde-o antes de recompor.
 *
 * Cabeçalho em duas colunas (título · texto), 3 cards claros com foto, cobertura e energia
 * lado a lado, recurso principal e CTA de largura total; abaixo, só a nota. A faixa "Não sabe
 * qual torre escolher?" saiu em 03/11/2026 por repetir o painel `identificar` logo abaixo, como
 * na LP SEIVE. `dark` fica nos dados só pelo contrato da biblioteca.
 */
import Button from '@components/Button.astro'
import Eyebrow from '@components/Eyebrow.astro'
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import BrandCarousel from '@components/BrandCarousel.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { productLines } from '@data/sections/linhas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const lines = productLines.items
const [titleStart, titleEnd = ''] = productLines.title.split(productLines.titleHighlight)
const hasHighlight = productLines.title.includes(productLines.titleHighlight)
---

<Section id="linhas" tone={tone} rhythm={rhythm}>
  <div class="grid gap-5 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] xl:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
    <div>
      <Eyebrow>{productLines.eyebrow}</Eyebrow>
      <h2 class="mt-4 font-display leading-[1.08] font-extrabold tracking-[-0.02em] text-primary-dark-900 text-[1.75rem] sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem]">
        {hasHighlight ? (
          <Fragment>
            {titleStart}
            <span class="text-accent-orange lg:block">{productLines.titleHighlight}</span>
            {titleEnd}
          </Fragment>
        ) : (
          productLines.title
        )}
      </h2>
    </div>

    <p class="max-w-[30rem] font-sans text-[16px] leading-relaxed text-ink-soft sm:text-[17px] lg:pb-1.5 lg:text-[19px]">
      {productLines.text}
    </p>
  </div>

  <BrandCarousel />

  {/* A partir de 1280px cada card é um subgrid de 7 linhas: título, descrição, cobertura/energia,
      recurso e "Indicada para" ficam na mesma altura nos 3 cards, mesmo com descrições de tamanhos diferentes. */}
  <ul class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-3 xl:gap-y-0">
    {lines.map((line) => (
      <li class="group flex flex-col rounded-2xl border border-primary-dark/10 bg-neutral-light p-4 shadow-[0_14px_34px_-24px_rgba(10,29,77,0.35)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1 hover:border-accent-orange/40 hover:shadow-[0_28px_50px_-28px_rgba(10,29,77,0.45)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-5 xl:row-span-7 xl:grid xl:grid-rows-subgrid xl:gap-y-0">
        {/* Palco: o produto sobre cinza (multiply some com o fundo branco da foto), etiqueta no canto */}
        <div class="line-stage relative flex h-52 items-center justify-center overflow-hidden rounded-xl bg-neutral-gray-100 px-6 pt-9 pb-4">
          <span class="absolute top-3 left-3 rounded-full bg-neutral-light px-3 py-1 font-sans text-[11px] font-bold tracking-[0.16em] text-accent-orange-dark uppercase shadow-[0_1px_2px_rgba(13,29,48,0.08)]">
            {line.tag}
          </span>
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={640}
            loading="lazy"
            decoding="async"
            class="relative max-h-full w-auto max-w-full object-contain mix-blend-multiply transition-transform duration-500 ease-out group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
        </div>

        <h3 class="mt-5 font-display leading-tight font-extrabold text-primary-dark-900 text-[1.2rem]">
          {line.title}
        </h3>
        <p class="mt-2 font-sans text-[15px] leading-snug text-ink-soft">{line.description}</p>

        <dl class="mt-5 grid grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] border-b border-primary-dark/10 pb-4">
          <div class="pr-2.5">
            <dt class="font-sans text-[11px] font-semibold tracking-[0.14em] text-ink-soft uppercase">
              {productLines.specLabels[0]}
            </dt>
            <dd class="mt-1 font-display text-[16px] font-extrabold tracking-[-0.01em] whitespace-nowrap text-primary-dark-900 xl:text-[17px]">
              {line.features[0]}
            </dd>
          </div>
          <div class="border-l border-primary-dark/15 pl-3.5">
            <dt class="font-sans text-[11px] font-semibold tracking-[0.14em] text-ink-soft uppercase">
              {productLines.specLabels[1]}
            </dt>
            <dd class="mt-1 font-display text-[16px] font-extrabold tracking-[-0.01em] whitespace-nowrap text-primary-dark-900 xl:text-[17px]">
              {line.features[1]}
            </dd>
          </div>
        </dl>

        <p class="mt-4 flex items-center gap-3 font-sans text-[15px] font-medium text-ink">
          <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-accent-orange/10 text-accent-orange">
            <Icon name="zap" class="size-4" />
          </span>
          {line.features[2]}
        </p>

        <p class="mt-3 font-sans text-[14px] leading-snug text-ink-soft">
          <strong class="font-semibold text-primary-dark-900">{productLines.idealForLabel}:</strong>{' '}
          {line.idealFor}
        </p>

        {/* mt-auto alinha os botões na base quando os textos têm alturas diferentes */}
        <div class="mt-auto pt-5">
          <Button cta={`linhas-${line.id}`} size="md" class="w-full">
            {cta.card}
          </Button>
        </div>
      </li>
    ))}
  </ul>

  <p class="mt-4 font-sans text-[12.5px] text-ink-soft sm:text-right">{productLines.note}</p>
</Section>

<style>
  /* Luz suave atrás do produto: o palco fica cinza nas bordas e claro no centro. */
  .line-stage {
    background-image: radial-gradient(
      65% 60% at 50% 55%,
      rgb(255 255 255 / 0.95) 0%,
      transparent 72%
    );
  }
</style>
